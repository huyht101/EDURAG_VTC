# App and MySQL. DEMO/LOCAL ONLY; replace every credential for production.
COMPOSE_PROJECT_NAME=edurag_vtc
NODE_ENV=development
PORT=5000
APP_HOST_PORT=5001

# MySQL 8.4 (all application timestamps are UTC)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edurag
DB_USER=root
DB_PASSWORD=123456
MYSQL_ROOT_PASSWORD=123456
MYSQL_HOST_PORT=3306
# Remote Compose uses a separate loopback port for host-side E2E tooling.
# Containers always connect to the db service on port 3306.
REMOTE_MYSQL_HOST_PORT=13306
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000

# Authentication
JWT_SECRET=demo-only-jwt-secret-change-before-production-2026
JWT_EXPIRES_IN=7d
JWT_ISSUER=edurag-core
JWT_AUDIENCE=edurag-clients
BCRYPT_ROUNDS=12
TOKEN_HMAC_PEPPER=demo-only-token-hmac-pepper-change-production
# Demo OTP delivery writes one-time secrets to app logs. Disable in production.
AUTH_DEV_DELIVERY_LOG_SECRETS=true

# HTTP security. Empty CORS allowlist means no cross-origin response headers.
# Add only exact local frontend origins; never use wildcard *.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Keep 0 unless Node is behind a known reverse proxy; then set the exact hop count.
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
AUTH_SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
AUTH_SENSITIVE_RATE_LIMIT_MAX=10

# Storage
UPLOAD_DIR=uploads
FILE_MAX_SIZE_BYTES=20971520
AVATAR_MAX_SIZE_BYTES=5242880
DOCUMENT_PREVIEW_WORKER_ENABLED=true
DOCUMENT_PREVIEW_POLL_INTERVAL_MS=2000
DOCUMENT_PREVIEW_CONCURRENCY=2
DOCUMENT_PREVIEW_TIMEOUT_MS=120000
DOCUMENT_PREVIEW_RETRY_DELAY_SECONDS=30
LIBREOFFICE_COMMAND=soffice

# Canonical integration adapter. The base/mock Compose file still overrides this to mock.
RAG_MODE=remote
RAG_SERVICE_URL=http://localhost:8000
# Compose injects this value into Python as INTERNAL_SECRET. Minimum 32 characters.
RAG_INTERNAL_TOKEN=demo-only-rag-internal-token-change-production
RAG_SHARED_UPLOAD_DIR=/shared/uploads
RAG_CALLBACK_URL=http://localhost:5000/api/internal/rag/processing-callback
# Compatibility shim only; no subject scope is added to the database/public API.
RAG_DEFAULT_SUBJECT_ID=mvp-global
RAG_HISTORY_MESSAGE_LIMIT=20
RAG_CALLBACK_BODY_LIMIT=25mb
CHAT_PENDING_TIMEOUT_MS=120000

# Optional deterministic mock controls for development/tests only
RAG_MOCK_MULTI_USAGE=false
# RAG_MOCK_SOURCE_VECTOR_NODE_ID=<existing document_chunks.vector_node_id>

# Gemini/LlamaParse providers. Put real values only in the ignored root .env.
GOOGLE_API_KEY=
# OCR is explicit. OFF never requires or calls LlamaParse; AUTO requires the key below.
OCR_MODE=OFF
OCR_NATIVE_TEXT_MIN_CHARS=32
OCR_TIMEOUT_SECONDS=120
OCR_LANGUAGE=vi
LLAMA_CLOUD_API_KEY=
GEMINI_LLM_MODEL=models/gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768

# Python-owned Qdrant/model runtime
QDRANT_COLLECTION_NAME=education_docs
QDRANT_HTTP_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
PYTHON_HOST_PORT=8000

# Operation timeouts
RAG_REQUEST_TIMEOUT_MS=15000
RAG_QUERY_TIMEOUT_MS=180000
RAG_CALLBACK_TIMEOUT_SECONDS=30
RAG_CALLBACK_MAX_RETRIES=3
# Bounded exact-attempt activation retry after a valid Node machine ACK.
RAG_ACTIVATION_MAX_ATTEMPTS=3
RAG_ACTIVATION_RETRY_DELAY_SECONDS=0.25

# Remote Compose project. docker-compose.remote.yml reads this directly, so
# normal setup does not need `-p` or a terminal environment variable.
REMOTE_COMPOSE_PROJECT=edurag_remote_e2e
# Keep false while manually testing through Swagger. Set true only before the
# automated remote smoke, which is allowed to clean this isolated project.
REMOTE_E2E_CONFIRM_ISOLATED=false
REMOTE_E2E_CLEANUP=true
REMOTE_E2E_INGEST_TIMEOUT_MS=300000
REMOTE_E2E_OPERATION_TIMEOUT_MS=120000
REMOTE_E2E_REQUIRE_LLAMAPARSE=true
REMOTE_E2E_TEST_UNAVAILABLE=true

# Immutable cloud corpus bootstrap used by `npm run docker:remote:dev`.
# auto: restore only when all stores are empty; exact selected-release state is a verified no-op.
# Partial, unknown, busy or mismatched local state fails closed. required also fails on remote-read errors.
# off: never compare/download/restore.
CORPUS_BOOTSTRAP=auto
# GCS target must stay private/internal. The credential is host-side only and is never injected into Compose.
GCS_PROJECT_ID=your-google-cloud-project-id
GCS_BUCKET=your-private-corpus-bucket
GCS_OBJECT_PREFIX=portable-corpus/v1
GCS_CREDENTIALS_FILE=./secrets/gcs.json
# Optional exact Owner attestation used only when the corpus-writer can read/create
# objects but bucket privacy metadata introspection returns 403. Leave empty by default.
# Format: exact-project-id/exact-private-bucket-name
GCS_PRIVATE_TARGET_OWNER_ATTESTATION=
# false attaches only Node/Python logs; true also attaches MySQL/Qdrant logs.
REMOTE_DEV_ALL_LOGS=false
# Optional comma-separated Docker Compose service names for remote-dev log attachment.
# Empty keeps the default app,rag-service selection.
REMOTE_DEV_SERVICES=
SHUTDOWN_TIMEOUT_MS=10000
