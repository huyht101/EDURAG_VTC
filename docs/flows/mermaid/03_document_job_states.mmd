%% 03 Vòng đời document và processing job
flowchart TB
  subgraph DOC[documents.processing_status]
    direction LR
    DU[UPLOADED] -->|Bắt đầu INGEST| DP[PROCESSING]
    DP -->|Callback thành công| DR[READY]
    DP -->|Lỗi xác định| DF[FAILED]
    DP -->|Hủy| DC[CANCELLED]
  end

  subgraph VIS[documents.visibility_status]
    direction LR
    VV[VISIBLE] -->|SET_RETRIEVAL false thành công| VH[HIDDEN]
    VH -->|READY và unhide thành công| VV
    VV -->|DELETE_VECTORS thành công| VD[DELETED]
    VH -->|DELETE_VECTORS thành công| VD
  end

  subgraph JOB[document_processing_jobs.status]
    direction LR
    JQ[QUEUED] -->|Dispatch, tăng attempt_count| JR[RUNNING]
    JQ -->|Bị delete supersede| JC[CANCELLED]
    JR -->|Callback thành công| JS[SUCCEEDED]
    JR -->|Lỗi xác định| JF[FAILED]
    JR -->|Hủy/delete| JC
  end

  STALE[Callback stale] -.-> IGNORED[ACK ignored; không đổi state]
  UNKNOWN[Dispatch timeout] -.-> JR
  RESERVED[REPROCESS/max_attempts có trong schema; không có public reprocess hoặc auto retry]

  DR ~~~ VV
  VD ~~~ JQ
  JC ~~~ STALE
