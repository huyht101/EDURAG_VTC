{
  "name": "vtc-rag-backend",
  "version": "1.0.0",
  "description": "Backend API cho hệ thống trợ lý học tập RAG",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "documents:backfill": "node scripts/backfill-document-previews.js",
    "check": "node scripts/check-syntax.js",
    "test:openapi": "node scripts/openapi-test.js",
    "test:docs": "node scripts/docs-link-test.js",
    "test:corpus": "node scripts/corpus-release-test.js",
    "test:corpus:partial": "node scripts/corpus-partial-state-test.js",
    "test:corpus:live": "node scripts/restored-corpus-live-smoke.js",
    "test:contract": "node scripts/rag-contract-test.js",
    "test:library": "node scripts/library-contract-test.js",
    "test:document-schema": "node scripts/document-schema-check.js",
    "test:documents": "node scripts/document-preview-test.js",
    "test:docx-preview:docker": "node scripts/docker-docx-preview-test.js",
    "test:node-consolidation": "node scripts/node-consolidation-test.js",
    "test:part2": "node scripts/part2-smoke.js",
    "docker:mock:config": "docker compose config --quiet",
    "docker:mock:up": "docker compose up -d --build --wait",
    "docker:mock:ps": "docker compose ps",
    "docker:mock:logs:app": "docker compose logs app --tail 200",
    "docker:mock:down": "docker compose down",
    "docker:mock:reset": "docker compose down -v --remove-orphans",
    "docker:remote:config": "node scripts/remote-test-utils.js config --quiet",
    "docker:remote:ps": "node scripts/remote-test-utils.js ps",
    "docker:remote:logs:app": "node scripts/remote-test-utils.js logs app --tail 200",
    "docker:remote:logs:rag": "node scripts/remote-test-utils.js logs rag-service --tail 200",
    "docker:remote:files:node": "node scripts/remote-test-utils.js exec -T app find /usr/src/app/uploads/documents -type f",
    "docker:remote:files:rag": "node scripts/remote-test-utils.js exec -T rag-service find /shared/uploads/documents -type f",
    "docker:remote:mysql": "node scripts/remote-test-utils.js exec db mysql -uroot -p edurag",
    "docker:remote:down": "node scripts/remote-test-utils.js down",
    "docker:remote:stop": "node scripts/remote-test-utils.js stop",
    "docker:remote:dev": "node scripts/remote-dev.js",
    "docker:remote:reset": "node scripts/remote-test-utils.js down -v --remove-orphans",
    "corpus:inspect": "node scripts/corpus-manager.js inspect",
    "corpus:audit": "node scripts/corpus-prepublish-audit.js",
    "corpus:publish": "node scripts/corpus-manager.js publish",
    "corpus:verify": "node scripts/corpus-manager.js verify",
    "corpus:restore": "node scripts/corpus-manager.js restore",
    "test:remote-dev-lifecycle": "node scripts/remote-dev-lifecycle-test.js",
    "preflight:remote": "node scripts/remote-preflight.js",
    "test:remote": "node scripts/remote-e2e-smoke.js"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "8.6.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.9.7",
    "pdf-lib": "1.17.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@google-cloud/storage": "7.21.0"
  }
}
