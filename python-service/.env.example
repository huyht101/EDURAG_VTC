# ============================================================
# Python RAG Service — .env.example
# ============================================================
# Dùng cho standalone Python dev (chạy riêng, không qua Docker).
# Khi chạy tích hợp qua docker-compose, stack đọc từ root ../.env.
#
# Cách dùng:
#   cp .env.example .env
#   # Điền các giá trị bắt buộc (có dấu ***)
#   uvicorn main:app --reload --host 0.0.0.0 --port 8000

# ============================================================
# === [BẮT BUỘC] Google Gemini API ===
# ============================================================
# *** Lấy tại: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ============================================================
# === [BẮT BUỘC] LlamaParse (LlamaIndex Cloud) ===
# ============================================================
# *** Lấy tại: https://cloud.llamaindex.ai/
# Bỏ trống nếu chỉ dùng fallback parser (pypdf/python-docx).
LLAMA_CLOUD_API_KEY=

# ============================================================
# === [BẮT BUỘC] Internal Secret ===
# ============================================================
# *** Phải giống với INTERNAL_SECRET trong root .env của Node.js.
# Dùng để xác thực callback từ Python về Node.
# Sinh ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SECRET=

# ============================================================
# === Gemini Model Names ===
# ============================================================
# Model cho RAG answer và chit-chat (temperature=0.1)
GEMINI_LLM_MODEL=models/gemini-2.5-flash

# Model cho Query Router (temperature=0, deterministic)
# Có thể dùng cùng model hoặc model nhỏ hơn để tiết kiệm chi phí

# Model cho embedding (768 chiều)
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Số chiều vector — phải khớp với QDRANT_COLLECTION vector size
EMBEDDING_DIMENSION=768

# ============================================================
# === Qdrant Vector Database ===
# ============================================================
# URL tới Qdrant server (Docker local hoặc Qdrant Cloud)
QDRANT_URL=http://localhost:6333

# API key nếu dùng Qdrant Cloud (bỏ trống nếu local)
QDRANT_API_KEY=

# Tên collection — tự động tạo nếu chưa có
QDRANT_COLLECTION_NAME=education_docs

# ============================================================
# === RAG Parameters ===
# ============================================================
# Kích thước chunk (tokens) — ảnh hưởng đến retrieval chất lượng
CHUNK_SIZE=512

# Overlap giữa các chunks (tokens)
CHUNK_OVERLAP=50

# Số lượng chunk retrieval tối đa mỗi query
TOP_K=5

# Ngưỡng similarity tối thiểu — chunk dưới mức này bị bỏ qua
# Range: 0.0–1.0. Thấp hơn = recall cao hơn nhưng noise nhiều hơn.
SIMILARITY_THRESHOLD=0.35

# ============================================================
# === CORS (chỉ dùng khi Python expose trực tiếp) ===
# ============================================================
# Trong production, Node.js gọi Python qua internal network → CORS không quan trọng
CORS_ORIGINS=["http://localhost:3000","http://localhost:5001"]

# ============================================================
# === Callback Settings ===
# ============================================================
# Timeout (giây) cho mỗi lần thử callback về Node.js
CALLBACK_TIMEOUT=30

# Số lần retry tối đa nếu callback thất bại (exponential backoff)
CALLBACK_MAX_RETRIES=3
